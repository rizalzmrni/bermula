{
  "permissions": {
    "ask": ["Bash(gh pr merge:*)", "Bash(bun run db:migrate:*)"],
    "deny": ["Bash(gh pr merge --admin:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bunx ultracite fix --hook",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  }
}
