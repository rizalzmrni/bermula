{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typegen": {
      "outputs": [".react-router/types/**", "worker-configuration.d.ts"]
    },
    "build:types": {
      "dependsOn": ["transit", "typegen"],
      "outputs": ["dist/types/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["build/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["transit", "typegen", "^build:types"]
    },
    "test": {
      "dependsOn": ["transit", "typegen"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
