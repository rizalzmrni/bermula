{
  "name": "@bermula/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./schema/*": "./src/schema/*.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@bermula/core": "workspace:*",
    "@neondatabase/serverless": "catalog:db",
    "drizzle-orm": "catalog:db"
  },
  "devDependencies": {
    "@bermula/typescript-config": "workspace:*",
    "@electric-sql/pglite": "catalog:db",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:db",
    "typescript": "catalog:"
  }
}
