# Salin ke .env untuk development lokal. Dibaca Vite saat build, ikut ke bundle browser: jangan isi secret.
# Skema: packages/env/src/web.ts

# Fungsi: Origin publik apps/app, untuk tautan login/daftar dari situs marketing
# Wajib: ya | Sisi: client | Contoh format: http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Fungsi: Origin publik situs ini (apps/web), untuk canonical, Open Graph, dan sitemap
# Wajib: ya | Sisi: client | Contoh format: http://localhost:5174
VITE_WEB_URL=http://localhost:5174

# Fungsi: Izinkan mesin pencari mengindeks situs (robots.txt). Hanya `true` di produksi.
# Wajib: tidak (default false) | Sisi: client | Contoh format: true
VITE_ALLOW_INDEXING=
