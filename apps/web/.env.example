# Salin ke .env untuk development lokal. Dibaca Vite saat build, ikut ke bundle browser: jangan isi secret.
# Skema: packages/env/src/web.ts

# Fungsi: Origin publik apps/app, untuk tautan login/daftar dari situs marketing
# Wajib: ya | Sisi: client | Contoh format: http://localhost:5173
VITE_APP_URL=http://localhost:5173

# Fungsi: Origin publik situs ini (apps/web), untuk canonical, Open Graph, dan sitemap
# Wajib: ya | Sisi: client | Contoh format: http://localhost:5174
VITE_WEB_URL=http://localhost:5174

# Fungsi: Izinkan mesin pencari mengindeks situs (robots.txt). Hanya `true` di produksi.
# Wajib: tidak (default false) | Sisi: client | Contoh format: true
VITE_ALLOW_INDEXING=

# Fungsi: Measurement ID Google Analytics 4. Kosong = GA mati. Baru dimuat setelah pengunjung menyetujui cookie.
# Wajib: tidak | Sisi: client | Contoh format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Fungsi: Project token PostHog (publik, bukan personal API key). Kosong = PostHog mati. Baru dimuat setelah persetujuan cookie.
# Wajib: tidak (berpasangan dengan VITE_POSTHOG_HOST) | Sisi: client | Contoh format: phc_xxxxxxxx
VITE_POSTHOG_PROJECT_TOKEN=

# Fungsi: Host ingest PostHog sesuai region project
# Wajib: tidak (berpasangan dengan VITE_POSTHOG_PROJECT_TOKEN) | Sisi: client | Contoh format: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
