{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bermula-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-19",
  // Workers Logs: log JSON dari logger proyek tampil di dashboard Cloudflare.
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Situs marketing statis: tidak memanggil apps/api, jadi tanpa Service
  // Binding. Domain/route produksi belum ditetapkan (keputusan tertunda).
}
