{
  // Hanya untuk `build:types`: deklarasi `src/client.ts` bagi apps/app & apps/web.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types"
  },
  "include": ["src/client.ts", "worker-configuration.d.ts"]
}
